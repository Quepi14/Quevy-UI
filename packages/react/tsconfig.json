{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,

    "jsx": "react-jsx",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["react"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}